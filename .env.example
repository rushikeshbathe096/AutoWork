# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Any Groq model with tool calling. Alternatives: llama-3.3-70b-versatile, moonshotai/kimi-k2-instruct-0905
LLM_MODEL=openai/gpt-oss-120b
# Any OpenAI-compatible endpoint works
LLM_BASE_URL=https://api.groq.com/openai/v1
# Optional. Shared secret for the simulated world's /admin endpoints. Only needed when the eval
# harness runs in a different process from run.py (otherwise a random per-process token is used).
# SIMWORLD_ADMIN_TOKEN=change-me
