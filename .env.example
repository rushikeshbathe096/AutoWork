# ---- LLM provider (any OpenAI-compatible chat-completions API) ----
# Groq: get a key at https://console.groq.com/keys . GROQ_API_KEY is also accepted.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Any model with tool calling on your provider. Measured on Groq (see evals/results.md):
#   qwen/qwen3.8-27b    default: completed the example task verified
#   openai/gpt-oss-20b  works
#   openai/gpt-oss-120b currently fails: it writes its tool call inside its hidden reasoning (ADR 0006)
# Groq's free tier allows 200k tokens/day per model; one task costs roughly 60-80k.
LLM_MODEL=qwen/qwen3.8-27b
# LLM_TIMEOUT_S=90
# Output budget per call, INCLUDING hidden reasoning tokens for reasoning models such as gpt-oss.
# LLM_MAX_OUTPUT_TOKENS=4096
# Only for reasoning models that accept it (gpt-oss: low | medium | high). Unset = provider default, not sent.
# LLM_REASONING_EFFORT=

# ---- Run limits (validated at startup) ----
# AUTOWORK_MODE=balanced            # autonomous | balanced | supervised
# AUTOWORK_MAX_STEPS=40
# AUTOWORK_MAX_TOKENS=400000
# AUTOWORK_MAX_ACTIVE_SECONDS=1800  # excludes time waiting for a human

# ---- Optional ----
# Shared secret for the simulated world's /admin endpoints. Only needed when the eval harness runs
# in a different process from run.py (otherwise a random per-process token is used).
# SIMWORLD_ADMIN_TOKEN=change-me
# Credentials file for the login tool (default: config/vault.json, else the demo config/vault.example.json)
# AUTOWORK_VAULT_FILE=
